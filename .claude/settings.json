{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["scooter"],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(make help)",
      "Bash(make setup)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make run)",
      "Bash(make lock)",
      "Bash(make lock *)",
      "Bash(make check-settings)",
      "Bash(make clean)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(git push origin stage-*)",
      "Bash(git push -u origin stage-*)",
      "Bash(git push --set-upstream origin stage-*)",
      "Bash(git push -q origin stage-*)",
      "Bash(git push -q -u origin stage-*)",
      "Bash(git push -u -q origin stage-*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge --squash*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh api *)",
      "Edit(/Makefile)",
      "Edit(/requirements*)",
      "Edit(/scripts/**)",
      "mcp__scooter__recent_failures",
      "mcp__scooter__failure_counts",
      "mcp__scooter__scooter_history",
      "mcp__scooter__request_trace",
      "mcp__scooter__scooter_state",
      "mcp__scooter__anomalies",
      "mcp__scooter__ledger_check",
      "mcp__scooter__rollback_check",
      "mcp__scooter__check_invariants",
      "mcp__scooter__payment_lookup",
      "mcp__scooter__payment_draw",
      "mcp__scooter__reconcile_plan"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",
      "Bash(git -c *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/.mcp.json)",
      "Edit(/mcp_server.py)",
      "mcp__scooter__run_tests",
      "mcp__scooter__replay_fault",
      "mcp__scooter__reconcile_run"
    ],
    "deny": [
      "Bash(git push*--for*)",
      "Bash(git push*--mi*)",
      "Bash(git push*--al*)",
      "Bash(git push*--br*)",
      "Bash(git push*--pru*)",
      "Bash(git push*--de*)",
      "Bash(git push*--rece*)",
      "Bash(git push*--ex*)",
      "Bash(git push* -f*)",
      "Bash(git push* -d*)",
      "Bash(git push* -uf*)",
      "Bash(git push* -ud*)",
      "Bash(git push* -qf*)",
      "Bash(git push* -qd*)",
      "Bash(git push* -vf*)",
      "Bash(git push* -vd*)",
      "Bash(git push* -nf*)",
      "Bash(git push* -nd*)",
      "Bash(git push* -uuf*)",
      "Bash(git push* -uud*)",
      "Bash(git push* -uqf*)",
      "Bash(git push* -uqd*)",
      "Bash(git push* -uvf*)",
      "Bash(git push* -uvd*)",
      "Bash(git push* -unf*)",
      "Bash(git push* -und*)",
      "Bash(git push* -quf*)",
      "Bash(git push* -qud*)",
      "Bash(git push* -qqf*)",
      "Bash(git push* -qqd*)",
      "Bash(git push* -qvf*)",
      "Bash(git push* -qvd*)",
      "Bash(git push* -qnf*)",
      "Bash(git push* -qnd*)",
      "Bash(git push* -vuf*)",
      "Bash(git push* -vud*)",
      "Bash(git push* -vqf*)",
      "Bash(git push* -vqd*)",
      "Bash(git push* -vvf*)",
      "Bash(git push* -vvd*)",
      "Bash(git push* -vnf*)",
      "Bash(git push* -vnd*)",
      "Bash(git push* -nuf*)",
      "Bash(git push* -nud*)",
      "Bash(git push* -nqf*)",
      "Bash(git push* -nqd*)",
      "Bash(git push* -nvf*)",
      "Bash(git push* -nvd*)",
      "Bash(git push* -nnf*)",
      "Bash(git push* -nnd*)",
      "Bash(git push*master*)",
      "Bash(git push*refs/*)",
      "Bash(git push* +*)",
      "Bash(git push*'+*)",
      "Bash(git push*\"+*)",
      "Bash(git push* :**)",
      "Bash(git push*':**)",
      "Bash(git push*\":**)",
      "Bash(git -C * push*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * -XDELETE*)",
      "Bash(gh api -XDELETE*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh auth *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "gh *",
      "git push *"
    ],
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com",
        "localhost",
        "code.claude.com",
        "docs.github.com",
        "endoflife.date",
        "raw.githubusercontent.com",
        "json.schemastore.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyWrite": ["./.mcp.json"]
    }
  }
}
