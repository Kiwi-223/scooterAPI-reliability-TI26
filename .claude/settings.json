{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(make help)",
      "Bash(make setup)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make run)",
      "Bash(make lock)",
      "Bash(make lock *)",
      "Bash(make check-settings)",
      "Bash(make clean)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(git -C * worktree *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge --squash*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh api *)",
      "Edit(/Makefile)",
      "Edit(/requirements*)",
      "Edit(/scripts/**)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(git -c *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *:refs/heads/master*)",
      "Bash(git -C * push*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * -XDELETE*)",
      "Bash(gh api -XDELETE*)",
      "Bash(gh auth *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "gh *",
      "git push *"
    ],
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com",
        "localhost",
        "code.claude.com",
        "docs.github.com",
        "endoflife.date",
        "raw.githubusercontent.com",
        "json.schemastore.org"
      ],
      "allowLocalBinding": true
    }
  }
}
